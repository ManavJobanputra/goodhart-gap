# Copy to .env and fill in. .env is gitignored. Never commit real keys.
# Provider keys are read by name; values are never printed or logged.
DEEPSEEK_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
# Optional local model endpoint (Ollama). No key required.
OLLAMA_BASE_URL=http://localhost:11434/v1
# Set to 1 to enable live/network tests (default off).
GG_LIVE=
